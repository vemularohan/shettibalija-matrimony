# Shettibalija Matrimony - Environment Variables Configuration Template
# Copy this file to .env or .env.local and populate with your Supabase project credentials.

# Client-side Supabase Configuration (Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server / SSR Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
